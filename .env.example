# Copy to .env.local for local dev. On Vercel, set these in Project → Settings → Environment Variables
# (Upstash vars are injected automatically when you add Upstash Redis from the Vercel Marketplace).

UCP_PROFILE_URL=https://shopify.dev/ucp/agent-profiles/examples/2026-08-25/valid-with-capabilities.json

# Optional locally — without these the app uses an in-memory store (gifts vanish on restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Giver name shown in recipient copy ("Quynh sent you something").
NEXT_PUBLIC_GIVER_NAME=Quynh

# Claude vision for the "what her photo says" step (Screen 1c). Without it the step shows "Photo read is off".
ANTHROPIC_API_KEY=

# Canonical URL used for login and tracking links; HTTPS required in production.
APP_URL=http://localhost:3000
# Local only. Preview emails at /dev/mail; sends nothing. Disabled in production.
EMAIL_MODE=preview
# Production transactional email (verified sending domain required).
RESEND_API_KEY=
EMAIL_FROM=
# Bearer secret for scheduled GET /api/jobs/notifications.
CRON_SECRET=
